generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENCIA
  VENTAS
  CAJA
  DEPOSITO
  PRODUCCION
  RRHH
}

enum EmployeeStatus {
  ACTIVO
  INACTIVO
  LICENCIA
}

enum PayType {
  MENSUAL
  JORNAL
  DESTAJO
  MIXTO
}

enum AttendanceSource {
  RELOJ
  MANUAL
  CORRECCION
}

enum PayrollStatus {
  BORRADOR
  CERRADA
  PAGADA
  ANULADA
}

enum PayrollType {
  MENSUAL
  AGUINALDO
}

enum VacationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
}

enum AttendanceMarkType {
  ENTRADA
  SALIDA
}

enum CustomerType {
  PERSONA_FISICA
  PERSONA_JURIDICA
}

enum ProductType {
  FABRICADO
  REVENTA_LOCAL
  REVENTA_IMPORTADO
  MATERIA_PRIMA
}

enum UnitOfMeasure {
  UN
  PAR
  DOC
  MT
  KG
}

enum QuoteStatus {
  BORRADOR
  ENVIADO
  APROBADO
  RECHAZADO
  VENCIDO
}

enum OrderStatus {
  PENDIENTE
  EN_PRODUCCION
  LISTO
  DESPACHADO_PARCIAL
  DESPACHADO
  FACTURADO
  ANULADO
}

enum ShipmentStatus {
  PENDIENTE
  EN_TRANSITO
  ENTREGADO
  ANULADO
}

enum InvoiceType {
  FACTURA
  NOTA_CREDITO
}

enum InvoiceCondition {
  CONTADO
  CREDITO
}

enum SifenStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  CANCELADO
}

enum SifenEventType {
  ENVIO
  APROBACION
  RECHAZO
  CANCELACION
  INUTILIZACION
}

enum CashSessionStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  INGRESO_VENTA
  INGRESO_COBRO
  EGRESO_GASTO
  RETIRO
  DEPOSITO
}

enum StockMovementType {
  ENTRADA_COMPRA
  SALIDA_VENTA
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  CONSUMO_PRODUCCION
  INGRESO_PRODUCCION
  DEVOLUCION
}

enum PurchaseStatus {
  BORRADOR
  CONFIRMADA
  ANULADA
}

enum ProductionStatus {
  PLANIFICADA
  EN_PROCESO
  TERMINADA
  ANULADA
}

enum ProductionStageStatus {
  PENDIENTE
  EN_CURSO
  COMPLETADA
}

enum WorkshopType {
  PROPIO
  EXTERNO
}

enum SupplierOrigin {
  LOCAL
  IMPORTADO
}

enum ProductionPriority {
  BAJA
  MEDIA
  ALTA
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(VENTAS)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Company {
  id               String     @id @default(cuid())
  razonSocial      String
  nombreFantasia   String?
  ruc              String
  dv               String
  address          String
  city             String
  phone            String
  email            String
  actividadEconomica String
  logoUrl          String?
  timbrados        Timbrado[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Timbrado {
  id             String    @id @default(cuid())
  numero         String
  vigenciaDesde  DateTime
  vigenciaHasta  DateTime
  activo         Boolean   @default(true)
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  createdAt      DateTime  @default(now())
}

model ExpeditionPoint {
  id                   String        @id @default(cuid())
  establecimiento      String
  punto                String
  name                 String
  lastInvoiceNumber    Int           @default(0)
  lastCreditNoteNumber Int           @default(0)
  lastReceiptNumber    Int           @default(0)
  active               Boolean       @default(true)
  cashRegister         CashRegister?
  invoices             Invoice[]
  receipts             Receipt[]
  createdAt            DateTime      @default(now())

  @@unique([establecimiento, punto])
}

model CashRegister {
  id                String          @id @default(cuid())
  name              String          @unique
  expeditionPointId String          @unique
  expeditionPoint   ExpeditionPoint @relation(fields: [expeditionPointId], references: [id])
  active            Boolean         @default(true)
  sessions          CashSession[]
  posTerminals      PosTerminal[]
  createdAt         DateTime        @default(now())
}

model Customer {
  id           String       @id @default(cuid())
  code         String?      @unique
  type         CustomerType
  name         String
  rucBase      String
  dv           String
  address      String?
  city         String
  phone        String?
  email        String?
  priceListId  String
  priceList    PriceList    @relation(fields: [priceListId], references: [id])
  creditLimit  Int          @default(0)
  termDays     Int          @default(30)
  active       Boolean      @default(true)
  quotes       Quote[]
  orders       SalesOrder[]
  invoices     Invoice[]
  receipts     Receipt[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([name])
  @@index([rucBase])
}

model Supplier {
  id            String         @id @default(cuid())
  code          String?        @unique
  name          String
  rucBase       String
  dv            String
  contactName   String?
  phone         String?
  email         String?
  origin        SupplierOrigin @default(LOCAL)
  active        Boolean        @default(true)
  purchaseReceipts PurchaseReceipt[]
  expenses      Expense[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ProductGroup {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  groupId      String
  group        ProductGroup  @relation(fields: [groupId], references: [id])
  type         ProductType
  unit         UnitOfMeasure @default(UN)
  taxRate      Int           @default(10)
  cost         Int
  basePrice    Int
  minStock     Int           @default(0)
  hasVariants  Boolean       @default(false)
  active       Boolean       @default(true)
  description  String?
  variants     ProductVariant[]
  bom          BillOfMaterials?
  productionOrders ProductionOrder[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([groupId])
  @@index([type])
}

model ProductVariant {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String          @default("ÚNICA")
  color         String          @default("—")
  sku           String          @unique
  priceOverride Int?
  active        Boolean         @default(true)
  stockLevels   StockLevel[]
  stockMovements StockMovement[]
  quoteLines    QuoteLine[]
  orderLines    SalesOrderLine[]
  shipmentLines ShipmentLine[]
  invoiceLines  InvoiceLine[]
  purchaseLines PurchaseReceiptLine[]
  priceItems    PriceListItem[]
  bomLines      BomLine[]
  productionLines ProductionOrderLine[]
  createdAt     DateTime        @default(now())

  @@unique([productId, size, color])
  @@index([productId])
}

model PriceList {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  isDefault   Boolean         @default(false)
  active      Boolean         @default(true)
  items       PriceListItem[]
  customers   Customer[]
  createdAt   DateTime        @default(now())
}

model PriceListItem {
  id              String     @id @default(cuid())
  priceListId     String
  priceList       PriceList  @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price           Int
  discountPercent Int        @default(0)

  @@unique([priceListId, variantId])
}

model Warehouse {
  id          String             @id @default(cuid())
  name        String             @unique
  type        String
  active      Boolean            @default(true)
  stockLevels StockLevel[]
  movements   StockMovement[]
  purchaseReceipts PurchaseReceipt[]
  shipments   Shipment[]
  consumptionOrders ProductionOrder[] @relation("ProductionConsumption")
  outputOrders ProductionOrder[] @relation("ProductionOutput")
  createdAt   DateTime           @default(now())
}

model StockLevel {
  id          String      @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  quantity    Int         @default(0)
  updatedAt   DateTime    @updatedAt

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id          String            @id @default(cuid())
  type        StockMovementType
  variantId   String
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  quantity    Int
  unitCost    Int               @default(0)
  originType  String?
  originId    String?
  userId      String?
  date        DateTime          @default(now())
  observation String?
  createdAt   DateTime          @default(now())

  @@index([variantId, date])
  @@index([warehouseId])
  @@index([date])
}

model PurchaseReceipt {
  id                    String         @id @default(cuid())
  number                String         @unique
  supplierId            String
  supplier              Supplier       @relation(fields: [supplierId], references: [id])
  supplierInvoiceNumber String
  warehouseId           String
  warehouse             Warehouse      @relation(fields: [warehouseId], references: [id])
  date                  DateTime
  status                PurchaseStatus @default(BORRADOR)
  total                 Int
  observations          String?
  userId                String?
  lines                 PurchaseReceiptLine[]
  createdAt             DateTime       @default(now())

  @@index([date])
}

model PurchaseReceiptLine {
  id        String          @id @default(cuid())
  receiptId String
  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id])
  quantity  Int
  unitCost  Int
  lineTotal Int
}

model Quote {
  id             String      @id @default(cuid())
  number         String      @unique
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  date           DateTime
  validityDays   Int         @default(15)
  status         QuoteStatus @default(BORRADOR)
  observations   String?
  subtotal       Int
  total          Int
  userId         String?
  lines          QuoteLine[]
  orders         SalesOrder[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([date])
}

model QuoteLine {
  id                 String         @id @default(cuid())
  quoteId            String
  quote              Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variantId          String
  variant            ProductVariant @relation(fields: [variantId], references: [id])
  quantity           Int
  unitPrice          Int
  discountPercent    Int            @default(0)
  isCustomized       Boolean        @default(false)
  customizationDetail String?
  taxRate            Int            @default(10)
  lineTotal          Int
}

model SalesOrder {
  id              String      @id @default(cuid())
  number          String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  quoteId         String?
  quote           Quote?      @relation(fields: [quoteId], references: [id])
  date            DateTime
  deliveryDate    DateTime
  shippingAddress String?
  status          OrderStatus @default(PENDIENTE)
  observations    String?
  total           Int
  userId          String?
  lines           SalesOrderLine[]
  shipments       Shipment[]
  invoices        Invoice[]
  productionOrders ProductionOrder[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([deliveryDate])
}

model SalesOrderLine {
  id                  String         @id @default(cuid())
  orderId             String
  order               SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id])
  quantity            Int
  quantityShipped     Int            @default(0)
  quantityInvoiced    Int            @default(0)
  unitPrice           Int
  discountPercent     Int            @default(0)
  taxRate             Int            @default(10)
  lineTotal           Int
  isCustomized        Boolean        @default(false)
  customizationDetail String?
  shipmentLines       ShipmentLine[]
}

model Shipment {
  id          String         @id @default(cuid())
  number      String         @unique
  orderId     String
  order       SalesOrder     @relation(fields: [orderId], references: [id])
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  carrier     String
  date        DateTime
  status      ShipmentStatus @default(PENDIENTE)
  observations String?
  userId      String?
  lines       ShipmentLine[]
  createdAt   DateTime       @default(now())

  @@index([date])
}

model ShipmentLine {
  id          String    @id @default(cuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   SalesOrderLine @relation(fields: [orderLineId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
}

model Invoice {
  id                String           @id @default(cuid())
  type              InvoiceType      @default(FACTURA)
  number            String
  expeditionPointId String
  expeditionPoint   ExpeditionPoint  @relation(fields: [expeditionPointId], references: [id])
  timbradoId        String
  timbrado          Timbrado         @relation(fields: [timbradoId], references: [id])
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id])
  condition         InvoiceCondition
  termDays          Int              @default(0)
  issueDate         DateTime
  dueDate           DateTime
  status            SifenStatus      @default(PENDIENTE)
  cdc               String           @unique
  xml               String           @db.Text
  subtotal10        Int              @default(0)
  subtotal5         Int              @default(0)
  exenta            Int              @default(0)
  iva10             Int              @default(0)
  iva5              Int              @default(0)
  total             Int
  paidAmount        Int              @default(0)
  balance           Int
  orderId           String?
  order             SalesOrder?      @relation(fields: [orderId], references: [id])
  sourceInvoiceId   String?
  sourceInvoice     Invoice?         @relation("CreditNotes", fields: [sourceInvoiceId], references: [id])
  creditNotes       Invoice[]        @relation("CreditNotes")
  userId            String?
  lines             InvoiceLine[]
  events            SifenEvent[]
  allocations       ReceiptAllocation[]
  cashMovements     CashMovement[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([expeditionPointId, type, number])
  @@index([issueDate])
  @@index([customerId])
  @@index([status])
  @@index([balance])
}

model InvoiceLine {
  id              String         @id @default(cuid())
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  description     String
  quantity        Int
  unitPrice       Int
  discountPercent Int            @default(0)
  taxRate         Int            @default(10)
  lineTotal       Int
  orderLineId     String?
}

model SifenEvent {
  id        String         @id @default(cuid())
  invoiceId String
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      SifenEventType
  date      DateTime       @default(now())
  message   String
  details   String?
  createdAt DateTime       @default(now())

  @@index([invoiceId])
}

model PosTerminal {
  id            String       @id @default(cuid())
  name          String
  code          String       @unique
  cashRegisterId String?
  cashRegister  CashRegister? @relation(fields: [cashRegisterId], references: [id])
  active        Boolean      @default(true)
  payments      ReceiptPayment[]
}

model PaymentMethod {
  id                 String   @id @default(cuid())
  name               String
  code               String   @unique
  type               String
  requiresPos        Boolean  @default(false)
  requiresReference  Boolean  @default(false)
  active             Boolean  @default(true)
  receiptPayments    ReceiptPayment[]
  cashMovements      CashMovement[]
  expenses           Expense[]
  payrollPeriods     PayrollPeriod[]
}

model CashSession {
  id             String            @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister      @relation(fields: [cashRegisterId], references: [id])
  userId         String?
  openedAt       DateTime
  openingAmount  Int
  closedAt       DateTime?
  countedAmount  Int?
  difference     Int?
  status         CashSessionStatus @default(ABIERTA)
  closingDetails Json?
  observations   String?
  receipts       Receipt[]
  movements      CashMovement[]
  expenses       Expense[]
  createdAt      DateTime          @default(now())

  @@index([cashRegisterId, openedAt])
  @@index([status])
}

model Receipt {
  id            String        @id @default(cuid())
  number        String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id])
  expeditionPointId String
  expeditionPoint ExpeditionPoint @relation(fields: [expeditionPointId], references: [id])
  date          DateTime
  total         Int
  userId        String?
  observations  String?
  allocations   ReceiptAllocation[]
  payments      ReceiptPayment[]
  cashMovements CashMovement[]
  createdAt     DateTime      @default(now())

  @@index([date])
  @@index([customerId])
}

model ReceiptAllocation {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Int

  @@unique([receiptId, invoiceId])
}

model ReceiptPayment {
  id              String        @id @default(cuid())
  receiptId       String
  receipt         Receipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  posTerminalId   String?
  posTerminal     PosTerminal?  @relation(fields: [posTerminalId], references: [id])
  amount          Int
  reference       String?
  bank            String?
  chequeNumber    String?
  createdAt       DateTime      @default(now())
}

model CashMovement {
  id              String           @id @default(cuid())
  cashSessionId   String
  cashSession     CashSession      @relation(fields: [cashSessionId], references: [id])
  type            CashMovementType
  paymentMethodId String
  paymentMethod   PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  amount          Int
  reference       String?
  description     String?
  date            DateTime         @default(now())
  receiptId       String?
  receipt         Receipt?         @relation(fields: [receiptId], references: [id])
  invoiceId       String?
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  createdAt       DateTime         @default(now())

  @@index([cashSessionId])
  @@index([date])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  color    String?
  active   Boolean   @default(true)
  expenses Expense[]
}

model Expense {
  id              String         @id @default(cuid())
  date            DateTime
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  voucherNumber   String?
  description     String
  amount          Int
  taxRate         Int            @default(10)
  paymentMethodId String
  paymentMethod   PaymentMethod  @relation(fields: [paymentMethodId], references: [id])
  cashSessionId   String?
  cashSession     CashSession?   @relation(fields: [cashSessionId], references: [id])
  paidFromCash    Boolean        @default(false)
  userId          String?
  createdAt       DateTime       @default(now())
  payrollPeriod   PayrollPeriod?

  @@index([date])
  @@index([categoryId])
}

model ProductionStage {
  id         String         @id @default(cuid())
  name       String         @unique
  sortOrder  Int
  active     Boolean        @default(true)
  bomStages  BomStage[]
  orderStages ProductionOrderStage[]
}

model Workshop {
  id            String    @id @default(cuid())
  name          String    @unique
  type          WorkshopType
  contact       String?
  phone         String?
  referenceCost Int       @default(0)
  active        Boolean   @default(true)
  bomStages     BomStage[]
  orderStages   ProductionOrderStage[]
  employees     Employee[]
}

model BillOfMaterials {
  id        String    @id @default(cuid())
  productId String    @unique
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  notes     String?
  active    Boolean   @default(true)
  lines     BomLine[]
  stages    BomStage[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model BomLine {
  id                String         @id @default(cuid())
  bomId             String
  bom               BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  materialVariantId String
  materialVariant   ProductVariant @relation(fields: [materialVariantId], references: [id])
  quantity          Int
  wastePercent      Int            @default(0)

  @@unique([bomId, materialVariantId])
}

model BomStage {
  id         String          @id @default(cuid())
  bomId      String
  bom        BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  stageId    String
  stage      ProductionStage @relation(fields: [stageId], references: [id])
  workshopId String?
  workshop   Workshop?       @relation(fields: [workshopId], references: [id])
  sortOrder  Int             @default(0)

  @@unique([bomId, stageId])
}

model ProductionOrder {
  id                   String              @id @default(cuid())
  number               String              @unique
  productId            String
  product              Product             @relation(fields: [productId], references: [id])
  orderId              String?
  order                SalesOrder?         @relation(fields: [orderId], references: [id])
  status               ProductionStatus    @default(PLANIFICADA)
  priority             ProductionPriority  @default(MEDIA)
  startDate            DateTime
  dueDate              DateTime
  quantity             Int
  consumptionWarehouseId String
  consumptionWarehouse Warehouse           @relation("ProductionConsumption", fields: [consumptionWarehouseId], references: [id])
  outputWarehouseId    String
  outputWarehouse      Warehouse           @relation("ProductionOutput", fields: [outputWarehouseId], references: [id])
  notes                String?
  userId               String?
  lines                ProductionOrderLine[]
  stages               ProductionOrderStage[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status])
  @@index([dueDate])
}

model ProductionOrderLine {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  quantity          Int

  @@unique([productionOrderId, variantId])
}

model ProductionOrderStage {
  id                String               @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder     @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageId           String
  stage             ProductionStage      @relation(fields: [stageId], references: [id])
  workshopId        String?
  workshop          Workshop?            @relation(fields: [workshopId], references: [id])
  status            ProductionStageStatus @default(PENDIENTE)
  completedQuantity Int                  @default(0)
  startDate         DateTime?
  endDate           DateTime?
  responsible       String?
  externalCost      Int                  @default(0)
  notes             String?
  sortOrder         Int                  @default(0)
  pieceworkEntries  PieceworkEntry[]

  @@unique([productionOrderId, stageId])
}

model Employee {
  id                   String         @id @default(cuid())
  code                 String         @unique
  firstName            String
  lastName             String
  ci                   String         @unique
  birthDate            DateTime?
  phone                String?
  email                String?
  address              String?
  emergencyContact     String?
  position             String
  department           String
  workshopId           String?
  workshop             Workshop?      @relation(fields: [workshopId], references: [id])
  hireDate             DateTime
  endDate              DateTime?
  status               EmployeeStatus @default(ACTIVO)
  payType              PayType
  monthlySalary        Int?
  dailyRate            Int?
  pieceRate            Int?
  scheduledStart       String         @default("07:30")
  scheduledEnd         String         @default("17:00")
  lunchMinutes         Int            @default(60)
  workDays             Int[]          @default([1, 2, 3, 4, 5, 6])
  lateToleranceMinutes Int            @default(10)
  pinHash              String
  vacationDaysOverride Int?
  notes                String?
  attendance           Attendance[]
  pieceworkEntries     PieceworkEntry[]
  vacationRequests     VacationRequest[]
  payrollItems         PayrollItem[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([status])
  @@index([department])
}

model Attendance {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date              DateTime
  checkIn           DateTime?
  checkOut          DateTime?
  breakMinutes      Int              @default(0)
  lateMinutes       Int              @default(0)
  earlyLeaveMinutes Int              @default(0)
  overtimeMinutes   Int              @default(0)
  workedMinutes     Int              @default(0)
  lateCount         Int              @default(0)
  source            AttendanceSource @default(RELOJ)
  notes             String?
  correctedById     String?
  photos            AttendancePhoto[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model PieceworkEntry {
  id                     String                @id @default(cuid())
  employeeId             String
  employee               Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                   DateTime
  quantity               Int
  unitRate               Int
  description            String?
  productionOrderStageId String?
  productionOrderStage   ProductionOrderStage? @relation(fields: [productionOrderStageId], references: [id])
  createdById            String?
  createdAt              DateTime              @default(now())

  @@index([employeeId, date])
  @@index([productionOrderStageId])
}

model VacationRequest {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  days        Int
  status      VacationStatus @default(PENDIENTE)
  reason      String?
  requestedAt DateTime       @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  notes       String?

  @@index([employeeId, status])
  @@index([startDate, endDate])
}

model PayrollPeriod {
  id               String         @id @default(cuid())
  number           String         @unique
  type             PayrollType
  year             Int
  month            Int
  startDate        DateTime
  endDate          DateTime
  status           PayrollStatus  @default(BORRADOR)
  grossTotal       Int            @default(0)
  ipsEmployeeTotal Int            @default(0)
  ipsEmployerTotal Int            @default(0)
  deductionsTotal  Int            @default(0)
  netTotal         Int            @default(0)
  extraTotal       Int            @default(0)
  pieceTotal       Int            @default(0)
  lateTotal        Int            @default(0)
  absenceTotal     Int            @default(0)
  vacationTotal    Int            @default(0)
  closedAt         DateTime?
  paidAt           DateTime?
  paymentMethodId  String?
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paidFromCash     Boolean        @default(false)
  expenseId        String?        @unique
  expense          Expense?       @relation(fields: [expenseId], references: [id])
  notes            String?
  userId           String?
  items            PayrollItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([type, year, month])
  @@index([status])
}

model PayrollItem {
  id               String        @id @default(cuid())
  payrollId        String
  payroll          PayrollPeriod @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee      @relation(fields: [employeeId], references: [id])
  payType          PayType
  baseAmount       Int           @default(0)
  workedDays       Int           @default(0)
  pieceUnits       Int           @default(0)
  pieceAmount      Int           @default(0)
  extraMinutes     Int           @default(0)
  extraAmount      Int           @default(0)
  lateMinutes      Int           @default(0)
  lateDeduction    Int           @default(0)
  absenceDays      Int           @default(0)
  absenceDeduction Int           @default(0)
  vacationDays     Int           @default(0)
  vacationAmount   Int           @default(0)
  otherEarnings    Int           @default(0)
  otherDeductions  Int           @default(0)
  grossAmount      Int           @default(0)
  ipsBase          Int           @default(0)
  ipsEmployee      Int           @default(0)
  ipsEmployer      Int           @default(0)
  netAmount        Int           @default(0)
  concepts         Json?
  notes            String?

  @@unique([payrollId, employeeId])
  @@index([employeeId])
}

model KioskSettings {
  id           String   @id @default("default")
  enabled      Boolean  @default(false)
  restrictIp   Boolean  @default(true)
  allowedIps   String   @default("")
  requirePhoto Boolean  @default(true)
  title        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AttendancePhoto {
  id           String             @id @default(cuid())
  attendanceId String
  attendance   Attendance         @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  type         AttendanceMarkType
  data         String
  mimeType     String             @default("image/jpeg")
  createdAt    DateTime           @default(now())

  @@unique([attendanceId, type])
  @@index([attendanceId])
}
